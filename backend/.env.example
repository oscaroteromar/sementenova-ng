# Copy this file to .env for local development.
# `docker-compose.yml` reads this same file for the backend service.

SECRET_KEY=dev-secret-key-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Matches the `db` service in docker-compose.yml
DATABASE_URL=postgres://scores:scores@db:5432/scores

# The Vue app's dev server origin(s), comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
